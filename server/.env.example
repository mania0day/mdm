# SENTROID MDM Server configuration
# Copy this file to .env and adjust values for your deployment.

# HTTP port the API + dashboard are served on
PORT=4000

# Bind address (0.0.0.0 lets the Android emulator reach it via 10.0.2.2)
HOST=0.0.0.0

# Secret used to sign admin JWT access tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET=sentroid-dev-secret-change-me-in-production

# Admin access-token lifetime
JWT_EXPIRES_IN=12h

# Seed super-admin credentials (created on first run if no users exist)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Administrator

# A device is flagged OFFLINE if it has not checked in within this many seconds
DEVICE_OFFLINE_THRESHOLD_SECONDS=60

# Environment
NODE_ENV=development
